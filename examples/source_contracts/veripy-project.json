{
  "version": 1,
  "sources": ["*.py"],
  "required_targets": ["measurements", "pauses"],
  "targets": [
    {
      "id": "measurements",
      "source": "measurements.py",
      "backend": "dafny",
      "functions": ["contains", "clip_readings", "advance"],
      "dependencies": [],
      "sidecar": "measurements.proofs.dfy"
    },
    {
      "id": "pauses",
      "source": "pauses.py",
      "backend": "dafny-native",
      "functions": ["RetryWindow.pause"],
      "dependencies": []
    }
  ],
  "artifacts": "proofs/generated",
  "dafny_version": "4.11.0"
}
